---
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Free agency onboarding template — NotionFlow</title>
  <meta name="description" content="Get the agency client onboarding checklist free. The same system that cuts onboarding from 4 hours to 45 minutes — yours instantly."/>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;1,9..40,300&display=swap" rel="stylesheet"/>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --ink:      #0f0e0d; --ink-2:    #3d3b38; --ink-3:    #7a7772;
      --paper:    #faf9f7; --paper-2:  #f0ede8; --paper-3:  #e4e0d9;
      --navy:     #1B2340; --accent:   #3B5BDB; --accent-2: #D0EBFF;
      --teal:     #0D9E75; --teal-2:   #DCFCE7;
      --serif:    'DM Serif Display', Georgia, serif;
      --sans:     'DM Sans', system-ui, sans-serif;
    }
    body { font-family: var(--sans); background: var(--paper); color: var(--ink); line-height: 1.6; }
    nav {
      display: flex; align-items: center; justify-content: space-between;
      padding: 0 clamp(1.5rem,5vw,4rem); height: 64px;
      border-bottom: 1px solid var(--paper-3);
    }
    .nav-logo { font-family: var(--serif); font-size: 1.25rem; color: var(--ink); text-decoration: none; }
    .nav-logo span { color: var(--accent); }
    .nav-back { font-size: .875rem; color: var(--ink-3); text-decoration: none; transition: color .15s; }
    .nav-back:hover { color: var(--accent); }
    .hero {
      max-width: 1100px; margin: 0 auto;
      padding: clamp(3rem,8vw,6rem) clamp(1.5rem,5vw,4rem);
      display: grid; grid-template-columns: 1fr 420px; gap: 5rem; align-items: center;
    }
    @media (max-width:860px) { .hero { grid-template-columns:1fr; gap:3rem; } }
    .hero-badge {
      display: inline-flex; align-items: center; gap: .5rem;
      background: var(--teal-2); color: var(--teal);
      font-size: .75rem; font-weight: 500; letter-spacing: .05em;
      text-transform: uppercase; padding: .375rem .875rem;
      border-radius: 100px; margin-bottom: 1.5rem;
    }
    .badge-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--teal); animation: pulse 2s infinite; }
    @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:.4} }
    .hero-title {
      font-family: var(--serif); font-size: clamp(2.25rem,5vw,3.5rem);
      line-height: 1.08; letter-spacing: -0.02em; margin-bottom: 1.5rem;
    }
    .hero-title em { font-style: italic; color: var(--accent); }
    .hero-desc { font-size: 1.0625rem; color: var(--ink-2); line-height: 1.75; margin-bottom: 2.5rem; max-width: 480px; }
    .gets { display: flex; flex-direction: column; gap: .75rem; }
    .get-item { display: flex; align-items: flex-start; gap: .875rem; }
    .get-check {
      width: 22px; height: 22px; border-radius: 7px;
      background: var(--teal-2); color: var(--teal);
      display: flex; align-items: center; justify-content: center;
      font-size: .75rem; flex-shrink: 0; margin-top: .1rem;
    }
    .get-text { font-size: .9875rem; color: var(--ink-2); line-height: 1.5; }
    .get-text strong { color: var(--ink); font-weight: 500; }
    .proof-strip {
      display: flex; align-items: center; gap: 1rem;
      margin-top: 2.5rem; padding-top: 2rem; border-top: 1px solid var(--paper-3);
    }
    .proof-avatars { display: flex; }
    .proof-avatar {
      width: 32px; height: 32px; border-radius: 50%;
      border: 2px solid var(--paper); display: flex; align-items: center;
      justify-content: center; font-family: var(--serif); font-size: .875rem;
      margin-left: -8px; color: #fff;
    }
    .proof-avatar:first-child { margin-left: 0; }
    .proof-text { font-size: .8125rem; color: var(--ink-3); line-height: 1.4; }
    .proof-text strong { color: var(--ink-2); font-weight: 500; }
    .form-card {
      background: #fff; border: 1px solid var(--paper-3); border-radius: 20px;
      overflow: hidden; box-shadow: 0 4px 6px -1px rgba(0,0,0,.04), 0 24px 48px -8px rgba(27,35,64,.12);
    }
    .form-card-header { background: var(--navy); padding: 1.75rem; position: relative; overflow: hidden; }
    .form-card-header svg { position: absolute; inset: 0; width: 100%; height: 100%; opacity: .12; }
    .form-card-label {
      font-size: .6875rem; font-weight: 500; letter-spacing: .08em;
      text-transform: uppercase; color: #A8B4D0; margin-bottom: .625rem; position: relative;
    }
    .form-card-title { font-family: var(--serif); font-size: 1.375rem; color: #fff; line-height: 1.2; position: relative; }
    .acc-bar { position: absolute; bottom: 0; left: 0; right: 0; height: 4px; background: var(--accent); }
    .form-card-body { padding: 1.75rem; }
    .form-group { margin-bottom: 1.125rem; }
    .form-label { display: block; font-size: .8125rem; font-weight: 500; color: var(--ink-2); margin-bottom: .5rem; }
    .form-input {
      width: 100%; padding: .75rem 1rem; border: 1px solid var(--paper-3);
      border-radius: 10px; font-family: var(--sans); font-size: .9375rem;
      color: var(--ink); background: var(--paper); outline: none; transition: border-color .15s;
    }
    .form-input:focus { border-color: var(--accent); background: #fff; }
    .form-input::placeholder { color: var(--ink-3); }
    .form-btn {
      width: 100%; padding: .9375rem; background: var(--accent); color: #fff;
      border: none; border-radius: 10px; font-family: var(--sans); font-size: 1rem;
      font-weight: 500; cursor: pointer; transition: opacity .15s; margin-top: .25rem;
    }
    .form-btn:hover { opacity: .88; }
    .form-note { font-size: .75rem; color: var(--ink-3); text-align: center; margin-top: .875rem; line-height: 1.5; }
    .form-divider { height: 1px; background: var(--paper-2); margin: 1.5rem 0; }
    .form-preview-label {
      font-size: .75rem; font-weight: 500; letter-spacing: .06em;
      text-transform: uppercase; color: var(--ink-3); margin-bottom: .875rem;
    }
    .preview-items { display: flex; flex-direction: column; gap: .5rem; }
    .preview-item {
      display: flex; align-items: center; gap: .75rem;
      padding: .625rem .875rem; background: var(--paper);
      border-radius: 8px; border: 1px solid var(--paper-3);
    }
    .preview-icon {
      width: 26px; height: 26px; border-radius: 6px;
      display: flex; align-items: center; justify-content: center;
      font-size: .75rem; font-weight: 600; flex-shrink: 0;
    }
    .pi-blue { background: var(--accent-2); color: var(--accent); }
    .pi-green { background: var(--teal-2); color: var(--teal); }
    .pi-navy { background: #E8EAF2; color: var(--navy); }
    .preview-name { font-size: .8125rem; font-weight: 500; }
    .preview-sub { font-size: .75rem; color: var(--ink-3); }
    .success-state { display: none; text-align: center; padding: 2rem 1.75rem; }
    .success-icon {
      width: 56px; height: 56px; border-radius: 50%;
      background: var(--teal-2); color: var(--teal);
      display: flex; align-items: center; justify-content: center;
      font-size: 1.5rem; margin: 0 auto 1rem;
    }
    .success-title { font-family: var(--serif); font-size: 1.5rem; margin-bottom: .75rem; }
    .success-desc { font-size: .9375rem; color: var(--ink-2); line-height: 1.7; margin-bottom: 1.5rem; }
    .success-link {
      display: inline-block; background: var(--navy); color: #fff;
      padding: .75rem 1.5rem; border-radius: 10px;
      font-size: .9375rem; font-weight: 500; text-decoration: none; transition: opacity .15s;
    }
    .success-link:hover { opacity: .85; }
    .testimonial-section { background: var(--navy); padding: clamp(3rem,6vw,5rem) clamp(1.5rem,5vw,4rem); }
    .testimonial-inner { max-width: 760px; margin: 0 auto; text-align: center; }
    .quote-mark { font-family: var(--serif); font-size: 4rem; color: #2E3A59; line-height: .6; margin-bottom: 1.5rem; }
    .quote-text {
      font-family: var(--serif); font-size: clamp(1.125rem,3vw,1.625rem);
      color: #fff; line-height: 1.45; margin-bottom: 1.75rem; letter-spacing: -0.01em;
    }
    .quote-text em { font-style: italic; color: #A8B4D0; }
    .quote-author { display: flex; align-items: center; justify-content: center; gap: .875rem; }
    .author-av {
      width: 38px; height: 38px; border-radius: 50%;
      background: var(--accent); color: #fff;
      display: flex; align-items: center; justify-content: center;
      font-family: var(--serif); font-size: .9375rem;
    }
    .author-name { font-weight: 500; font-size: .9375rem; color: #fff; }
    .author-role { font-size: .8125rem; color: #A8B4D0; }
    footer { background: var(--paper-2); border-top: 1px solid var(--paper-3); padding: 2rem clamp(1.5rem,5vw,4rem); }
    .footer-inner { max-width: 1100px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; }
    .footer-logo { font-family: var(--serif); font-size: 1.125rem; color: var(--ink); text-decoration: none; }
    .footer-logo span { color: var(--accent); }
    .footer-links { display: flex; gap: 1.5rem; list-style: none; }
    .footer-links a { font-size: .875rem; color: var(--ink-3); text-decoration: none; }
    .footer-links a:hover { color: var(--accent); }
    .footer-copy { font-size: .8125rem; color: var(--ink-3); }
  </style>
</head>
<body>

<nav>
  <a href="/" class="nav-logo">Notion<span>Flow</span></a>
  <a href="/templates" class="nav-back">← Browse all templates</a>
</nav>

<div class="hero">
  <div>
    <div class="hero-badge"><div class="badge-dot"></div>Free — no credit card</div>
    <h1 class="hero-title">Cut client onboarding from <em>4 hours to 45 minutes</em></h1>
    <p class="hero-desc">Get the exact Notion onboarding checklist used by 340+ agencies. Enter your email and the template link lands in your inbox instantly. Set it up this afternoon.</p>
    <div class="gets">
      <div class="get-item">
        <div class="get-check">✓</div>
        <div class="get-text"><strong>Client onboarding checklist</strong> — 10-step repeatable process that works for any new client, any project type</div>
      </div>
      <div class="get-item">
        <div class="get-check">✓</div>
        <div class="get-text"><strong>Welcome page template</strong> — branded, editable, ready to share with your first client today</div>
      </div>
      <div class="get-item">
        <div class="get-check">✓</div>
        <div class="get-text"><strong>5-minute setup guide</strong> — exactly what to change before sharing with a client</div>
      </div>
      <div class="get-item">
        <div class="get-check">✓</div>
        <div class="get-text"><strong>Weekly tips on agency ops</strong> — one useful email per week, unsubscribe any time</div>
      </div>
    </div>
    <div class="proof-strip">
      <div class="proof-avatars">
        <div class="proof-avatar" style="background:#1B2340">S</div>
        <div class="proof-avatar" style="background:#0D9E75">T</div>
        <div class="proof-avatar" style="background:#3B5BDB">M</div>
        <div class="proof-avatar" style="background:#E07B28">A</div>
      </div>
      <div class="proof-text"><strong>340+ agency owners</strong> already using this.<br/>Downloaded in the last 30 days.</div>
    </div>
  </div>

  <div>
    <div class="form-card">
      <div class="form-card-header">
        <svg viewBox="0 0 420 160" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
          <line x1="-80" y1="0" x2="20" y2="160" stroke="#fff" stroke-width="1.5"/>
          <line x1="-20" y1="0" x2="80" y2="160" stroke="#fff" stroke-width="1.5"/>
          <line x1="40" y1="0" x2="140" y2="160" stroke="#fff" stroke-width="1.5"/>
          <line x1="100" y1="0" x2="200" y2="160" stroke="#fff" stroke-width="1.5"/>
          <line x1="160" y1="0" x2="260" y2="160" stroke="#fff" stroke-width="1.5"/>
          <line x1="220" y1="0" x2="320" y2="160" stroke="#fff" stroke-width="1.5"/>
          <line x1="280" y1="0" x2="380" y2="160" stroke="#fff" stroke-width="1.5"/>
          <line x1="340" y1="0" x2="440" y2="160" stroke="#fff" stroke-width="1.5"/>
        </svg>
        <div class="form-card-label">Free template</div>
        <div class="form-card-title">Agency onboarding<br/>checklist</div>
        <div class="acc-bar"></div>
      </div>
      <div class="form-card-body">
        <div id="form-wrap">
          <form name="free-template" method="POST" data-netlify="true" netlify-honeypot="bot-field">
            <input type="hidden" name="form-name" value="free-template"/>
            <p style="display:none"><label>Don't fill: <input name="bot-field"/></label></p>
            <div class="form-group">
              <label class="form-label" for="fname">Your name</label>
              <input class="form-input" type="text" id="fname" name="name" placeholder="Sarah Moran" required/>
            </div>
            <div class="form-group">
              <label class="form-label" for="email">Work email</label>
              <input class="form-input" type="email" id="email" name="email" placeholder="sarah@youragency.com" required/>
            </div>
            <div class="form-group">
              <label class="form-label" for="agency">Agency name <span style="color:var(--ink-3);font-weight:400">(optional)</span></label>
              <input class="form-input" type="text" id="agency" name="agency" placeholder="Acme Creative Studio"/>
            </div>
            <button class="form-btn" type="submit">Send me the free template →</button>
            <p class="form-note">No spam. One useful email per week.<br/>Unsubscribe any time with one click.</p>
          </form>
        </div>
        <div class="success-state" id="success">
          <div class="success-icon">✓</div>
          <div class="success-title">Check your inbox</div>
          <div class="success-desc">The template link is on its way. While you wait — browse the full library to see what else we build for agencies.</div>
          <a href="/templates" class="success-link">Browse all templates</a>
        </div>
        <div class="form-divider"></div>
        <div class="form-preview-label">What's inside</div>
        <div class="preview-items">
          <div class="preview-item">
            <div class="preview-icon pi-blue">✓</div>
            <div><div class="preview-name">Onboarding checklist</div><div class="preview-sub">10 steps, duplicable for every client</div></div>
          </div>
          <div class="preview-item">
            <div class="preview-icon pi-green">🏠</div>
            <div><div class="preview-name">Welcome page template</div><div class="preview-sub">Branded, editable, ready to share</div></div>
          </div>
          <div class="preview-item">
            <div class="preview-icon pi-navy">📋</div>
            <div><div class="preview-name">Setup guide</div><div class="preview-sub">5 minutes to configure</div></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="testimonial-section">
  <div class="testimonial-inner">
    <div class="quote-mark">"</div>
    <p class="quote-text">I downloaded the free checklist on a Tuesday. By Thursday I had used it to onboard a new client. <em>It took 40 minutes.</em> The previous onboarding took most of a day.</p>
    <div class="quote-author">
      <div class="author-av">T</div>
      <div><div class="author-name">Tom Becker</div><div class="author-role">Founder, Bright Digital Studio</div></div>
    </div>
  </div>
</div>

<footer>
  <div class="footer-inner">
    <a href="/" class="footer-logo">Notion<span>Flow</span></a>
    <ul class="footer-links">
      <li><a href="/templates">Templates</a></li>
      <li><a href="/blog">Blog</a></li>
      <li><a href="/about">About</a></li>
      <li><a href="/privacy">Privacy</a></li>
    </ul>
    <p class="footer-copy">© 2026 NotionFlow</p>
  </div>
</footer>

<script>
function handleSubmit(e: SubmitEvent) {
  e.preventDefault();
  const form = e.target as HTMLFormElement;
  const data = new FormData(form);
  const encoded = Array.from(data.entries())
    .map(([k, v]) => encodeURIComponent(k) + '=' + encodeURIComponent(v as string))
    .join('&');
  fetch('/', {
    method: 'POST',
    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
    body: encoded,
  })
    .then(() => {
      const wrap = document.getElementById('form-wrap');
      const success = document.getElementById('success');
      if (wrap) wrap.style.display = 'none';
      if (success) success.style.display = 'block';
    })
    .catch(() => form.submit());
}

document.querySelector('form')?.addEventListener('submit', handleSubmit);
</script>
</body>
</html>