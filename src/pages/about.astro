<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>About — LayerBase</title>
  <meta name="description" content="The story behind NotionFlow — why I build Notion systems for agencies and what I've learned doing it."/>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;1,9..40,300&display=swap" rel="stylesheet"/>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --ink:      #0f0e0d;
      --ink-2:    #3d3b38;
      --ink-3:    #7a7772;
      --paper:    #faf9f7;
      --paper-2:  #f0ede8;
      --paper-3:  #e4e0d9;
      --accent:   #5c4ee8;
      --accent-2: #ede9ff;
      --accent-3: #c8c0f8;
      --teal:     #0d8a6a;
      --teal-2:   #e0f5ee;
      --amber:    #b86c10;
      --amber-2:  #fef0da;
      --serif:    'DM Serif Display', Georgia, serif;
      --sans:     'DM Sans', system-ui, sans-serif;
      --radius:   12px;
      --radius-lg:20px;
    }

    body {
      font-family: var(--sans); background: var(--paper);
      color: var(--ink); line-height: 1.6;
    }

    /* NAV */
    nav {
      position: sticky; top: 0; z-index: 100;
      display: flex; align-items: center; justify-content: space-between;
      padding: 0 clamp(1.5rem, 5vw, 4rem); height: 64px;
      background: rgba(250,249,247,.88); backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--paper-3);
    }
    .nav-logo {
      font-family: var(--serif); font-size: 1.25rem;
      color: var(--ink); text-decoration: none;
    }
    .nav-logo span { color: var(--accent); }
    .nav-links { display: flex; align-items: center; gap: 2rem; list-style: none; }
    .nav-links a {
      font-size: .875rem; color: var(--ink-2);
      text-decoration: none; transition: color .15s;
    }
    .nav-links a:hover, .nav-links a.active { color: var(--accent); }
    .nav-cta {
      background: var(--accent); color: #fff !important;
      padding: .5rem 1.25rem; border-radius: 8px; font-weight: 500 !important;
    }

    /* HERO */
    .hero {
      max-width: 1100px; margin: 0 auto;
      padding: clamp(3.5rem, 8vw, 6rem) clamp(1.5rem, 5vw, 4rem) clamp(2rem, 5vw, 4rem);
      display: grid; grid-template-columns: 1fr 360px;
      gap: 5rem; align-items: start;
    }
    @media (max-width: 860px) { .hero { grid-template-columns: 1fr; gap: 2.5rem; } }

    .hero-eyebrow {
      font-size: .75rem; font-weight: 500; letter-spacing: .08em;
      text-transform: uppercase; color: var(--accent); margin-bottom: 1rem;
    }
    .hero-title {
      font-family: var(--serif);
      font-size: clamp(2.25rem, 5vw, 3.25rem);
      line-height: 1.08; letter-spacing: -0.02em; margin-bottom: 1.5rem;
    }
    .hero-title em { font-style: italic; color: var(--accent); }
    .hero-lead {
      font-size: 1.125rem; color: var(--ink-2);
      line-height: 1.8; margin-bottom: 2rem;
    }

    /* AVATAR CARD */
    .avatar-card {
      background: #fff; border: 1px solid var(--paper-3);
      border-radius: var(--radius-lg); overflow: hidden;
      position: sticky; top: 84px;
    }
    .avatar-cover {
      height: 120px; background: var(--accent-2);
      position: relative; overflow: hidden;
    }
    .avatar-cover-deco {
      position: absolute; inset: 0;
      background: repeating-linear-gradient(
        45deg,
        transparent, transparent 20px,
        rgba(92,78,232,.08) 20px, rgba(92,78,232,.08) 21px
      );
    }
    .avatar-img {
      width: 72px; height: 72px; border-radius: 50%;
      background: var(--accent); color: #fff;
      display: flex; align-items: center; justify-content: center;
      font-family: var(--serif); font-size: 1.75rem;
      border: 3px solid var(--paper);
      position: absolute; bottom: -36px; left: 1.5rem;
    }
    .avatar-body { padding: 2.75rem 1.5rem 1.5rem; }
    .avatar-name {
      font-family: var(--serif); font-size: 1.25rem;
      margin-bottom: .25rem;
    }
    .avatar-role { font-size: .875rem; color: var(--ink-3); margin-bottom: 1.25rem; }
    .avatar-divider { height: 1px; background: var(--paper-2); margin: 1.25rem 0; }
    .avatar-stat-row { display: flex; flex-direction: column; gap: .875rem; }
    .avatar-stat { display: flex; align-items: center; gap: .75rem; }
    .avatar-stat-icon {
      width: 32px; height: 32px; border-radius: 8px;
      background: var(--paper-2); display: flex;
      align-items: center; justify-content: center;
      font-size: .875rem; flex-shrink: 0;
    }
    .avatar-stat-label { font-size: .8125rem; color: var(--ink-3); }
    .avatar-stat-val { font-size: .9375rem; font-weight: 500; }
    .avatar-links { display: flex; flex-direction: column; gap: .625rem; margin-top: 1.5rem; }
    .avatar-link {
      display: flex; align-items: center; justify-content: center;
      gap: .5rem; padding: .6875rem 1rem; border-radius: 10px;
      font-size: .875rem; font-weight: 500; text-decoration: none;
      transition: opacity .15s;
    }
    .avatar-link:hover { opacity: .82; }
    .link-primary { background: var(--accent); color: #fff; }
    .link-ghost {
      border: 1px solid var(--paper-3); color: var(--ink-2);
      background: transparent;
    }
    .link-ghost:hover { border-color: var(--accent-3); color: var(--accent); opacity: 1; }

    /* PROSE BODY */
    .prose-body {
      max-width: 1100px; margin: 0 auto;
      padding: 0 clamp(1.5rem, 5vw, 4rem);
      display: grid; grid-template-columns: 1fr 360px;
      gap: 5rem;
    }
    @media (max-width: 860px) { .prose-body { grid-template-columns: 1fr; } }
    .prose-col {}
    .aside-col {}

    .prose h2 {
      font-family: var(--serif); font-size: 1.625rem;
      color: var(--ink); margin: 3rem 0 1rem;
      letter-spacing: -0.01em; line-height: 1.2;
    }
    .prose h2:first-child { margin-top: 0; }
    .prose p {
      font-size: .9875rem; color: var(--ink-2);
      line-height: 1.85; margin-bottom: 1.25rem;
    }
    .prose strong { color: var(--ink); font-weight: 500; }

    /* PULL QUOTE */
    .pull-quote {
      border-left: 3px solid var(--accent);
      padding: 1rem 0 1rem 1.5rem;
      margin: 2rem 0;
    }
    .pull-quote p {
      font-family: var(--serif); font-size: 1.25rem;
      color: var(--ink); line-height: 1.45;
      font-style: italic; margin: 0;
    }

    /* TIMELINE */
    .timeline { position: relative; margin: 2rem 0; }
    .timeline::before {
      content: ''; position: absolute;
      left: 14px; top: 8px; bottom: 8px;
      width: 1px; background: var(--paper-3);
    }
    .tl-item { display: flex; gap: 1.25rem; margin-bottom: 1.75rem; position: relative; }
    .tl-dot {
      width: 29px; height: 29px; border-radius: 50%;
      background: #fff; border: 1px solid var(--paper-3);
      display: flex; align-items: center; justify-content: center;
      flex-shrink: 0; z-index: 1;
    }
    .tl-dot-inner {
      width: 9px; height: 9px; border-radius: 50%;
    }
    .dot-purple { background: var(--accent); }
    .dot-teal   { background: var(--teal); }
    .dot-amber  { background: var(--amber); }
    .dot-gray   { background: var(--ink-3); }
    .tl-content {}
    .tl-year { font-size: .75rem; font-weight: 500; color: var(--ink-3); margin-bottom: .25rem; }
    .tl-title { font-size: .9875rem; font-weight: 500; color: var(--ink); margin-bottom: .25rem; }
    .tl-desc { font-size: .875rem; color: var(--ink-3); line-height: 1.6; }

    /* WHAT I BELIEVE */
    .beliefs { display: flex; flex-direction: column; gap: .875rem; margin: 2rem 0; }
    .belief {
      display: flex; gap: 1rem; padding: 1rem 1.125rem;
      border: 1px solid var(--paper-3); border-radius: var(--radius);
      background: #fff;
    }
    .belief-num {
      font-family: var(--serif); font-size: 1.125rem;
      color: var(--accent-3); flex-shrink: 0; line-height: 1.3;
      width: 24px; text-align: right;
    }
    .belief-text { font-size: .9375rem; color: var(--ink-2); line-height: 1.65; }
    .belief-text strong { color: var(--ink); font-weight: 500; display: block; margin-bottom: .125rem; }

    /* ASIDE CARDS */
    .aside-card {
      background: #fff; border: 1px solid var(--paper-3);
      border-radius: var(--radius-lg); padding: 1.25rem;
      margin-bottom: 1.25rem;
    }
    .aside-title {
      font-size: .75rem; font-weight: 500; letter-spacing: .07em;
      text-transform: uppercase; color: var(--ink-3); margin-bottom: 1rem;
    }
    .tool-list { display: flex; flex-direction: column; gap: .75rem; }
    .tool-item { display: flex; align-items: center; gap: .875rem; }
    .tool-icon {
      width: 34px; height: 34px; border-radius: 9px;
      display: flex; align-items: center; justify-content: center;
      font-size: .875rem; font-weight: 600; flex-shrink: 0;
    }
    .ti-notion  { background: var(--ink); color: var(--paper); }
    .ti-loom    { background: #625DF5; color: #fff; }
    .ti-gumroad { background: #FF90E8; color: var(--ink); }
    .ti-figma   { background: #F24E1E; color: #fff; }
    .ti-astro   { background: #FF5D01; color: #fff; }
    .tool-name  { font-size: .9375rem; font-weight: 500; }
    .tool-desc  { font-size: .8125rem; color: var(--ink-3); }

    .faq-list { display: flex; flex-direction: column; gap: .75rem; }
    .faq-item {}
    .faq-q {
      font-size: .9rem; font-weight: 500; color: var(--ink);
      margin-bottom: .375rem;
    }
    .faq-a { font-size: .8375rem; color: var(--ink-3); line-height: 1.6; }

    /* CTA */
    .cta-strip {
      background: var(--ink);
      padding: clamp(3rem, 6vw, 5rem) clamp(1.5rem, 5vw, 4rem);
      margin-top: clamp(3rem, 6vw, 5rem);
      text-align: center;
    }
    .cta-inner { max-width: 560px; margin: 0 auto; }
    .cta-title {
      font-family: var(--serif);
      font-size: clamp(1.75rem, 4vw, 2.5rem);
      color: var(--paper); line-height: 1.1;
      letter-spacing: -0.02em; margin-bottom: .875rem;
    }
    .cta-title em { font-style: italic; color: var(--accent-3); }
    .cta-sub {
      font-size: .9375rem; color: rgba(250,249,247,.6);
      line-height: 1.7; margin-bottom: 2rem;
    }
    .cta-actions { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }
    .btn-inv {
      background: var(--paper); color: var(--ink);
      padding: .875rem 2rem; border-radius: 10px;
      font-size: .9375rem; font-weight: 500;
      text-decoration: none; transition: opacity .15s;
    }
    .btn-inv:hover { opacity: .88; }
    .btn-outline {
      border: 1px solid rgba(255,255,255,.2); color: var(--paper);
      padding: .875rem 2rem; border-radius: 10px;
      font-size: .9375rem; text-decoration: none;
      transition: border-color .15s;
    }
    .btn-outline:hover { border-color: rgba(255,255,255,.5); }

    /* FOOTER */
    footer {
      background: var(--paper-2); border-top: 1px solid var(--paper-3);
      padding: 2.5rem clamp(1.5rem, 5vw, 4rem);
    }
    .footer-inner {
      max-width: 1100px; margin: 0 auto;
      display: flex; justify-content: space-between;
      align-items: center; flex-wrap: wrap; gap: 1rem;
    }
    .footer-logo {
      font-family: var(--serif); font-size: 1.125rem;
      color: var(--ink); text-decoration: none;
    }
    .footer-logo span { color: var(--accent); }
    .footer-links { display: flex; gap: 1.5rem; list-style: none; }
    .footer-links a {
      font-size: .875rem; color: var(--ink-3); text-decoration: none;
    }
    .footer-links a:hover { color: var(--accent); }
    .footer-copy { font-size: .8125rem; color: var(--ink-3); }
  </style>
</head>
