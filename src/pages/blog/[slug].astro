      <a href={data.gumroadUrl} class="btn-buy" target="_blank">
        Buy now — €{data.price}
      </a>
      <a href="#preview" class="btn-preview">See full preview</a>

      <div class="card-features">
        <div class="card-feature">
          <div class="cf-icon">✓</div>
          <span>Instant Notion template access</span>
        </div>
        <div class="card-feature">
          <div class="cf-icon">✓</div>
          <span>5 linked databases, fully configured</span>
        </div>
        <div class="card-feature">
          <div class="cf-icon">✓</div>
          <span>8-minute setup Loom + PDF guide</span>
        </div>
        <div class="card-feature">
          <div class="cf-icon">✓</div>
          <span>Lifetime updates included</span>
        </div>
        <div class="card-feature">
          <div class="cf-icon">✓</div>
          <span>48-hour email support</span>
        </div>
      </div>

      <div class="card-divider2"></div>

      <div style="font-size:.8125rem;font-weight:500;color:var(--ink-2);margin-bottom:.875rem">How to get started</div>
      <div class="setup-steps">
        <div class="setup-step"><div class="step-n">1</div>Buy and open the Notion link in your email</div>
        <div class="setup-step"><div class="step-n">2</div>Click "Duplicate" to copy to your workspace</div>
        <div class="setup-step"><div class="step-n">3</div>Follow the 10-item setup checklist inside</div>
        <div class="setup-step"><div class="step-n">4</div>Share the portal link with your first client</div>
      </div>

      <div class="card-divider2"></div>

      <div class="card-guarantee">
        <strong>30-day guarantee.</strong> If you set the template up, share it with a client, and genuinely don't think it was worth it — email me and I'll refund you in full. No questions asked.
      </div>
    </div>
  </div>

</div>

<!-- RELATED TEMPLATES -->
{related.length > 0 && (
  <div class="related-section">
    <div class="related-inner">
      <div class="related-title">You might also need</div>
      <div class="related-grid">
        {related.map(t => (
          <a href={`/templates/${entrySlug(t)}`} class="related-card">
            <div class="related-cover"></div>
            <div class="related-body">
              <div class="related-name">{t.data.title}</div>
              <div class="related-price">€{t.data.price}</div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
)}

<!-- FOOTER -->
<footer>
  <div class="footer-inner">
    <a href="/" class="footer-logo">Notion<span>Flow</span></a>
    <ul class="footer-links">
      <li><a href="/templates">Templates</a></li>
      <li><a href="/blog">Blog</a></li>
      <li><a href="/contact">Contact</a></li>
      <li><a href="/about">About</a></li>
    </ul>
    <p class="footer-copy">© 2026 NotionFlow</p>
  </div>
</footer>

<script>
function switchTab(el: { classList: { add: (arg0: string) => void; }; }, id: string) {
  document.querySelectorAll('.ptab').forEach(t => t.classList.remove('active'));
  el.classList.add('active');
  ['overview','tasks','feedback'].forEach(tab => {
    const el = document.getElementById('tab-' + tab);
    if (el) el.style.display = tab === id ? 'block' : 'none';
  });
}
</script>

</body>
</html>