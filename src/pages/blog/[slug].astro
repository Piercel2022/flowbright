---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await render(post);

const { title, description, pubDate, tags, cover } = post.data;
const formattedDate = new Date(pubDate).toLocaleDateString('en-GB', {
  day: 'numeric', month: 'long', year: 'numeric'
});
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>{title} — NotionFlow</title>
  <meta name="description" content={description}/>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;1,9..40,300&display=swap" rel="stylesheet"/>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --ink: #0f0e0d; --ink-2: #3d3b38; --ink-3: #7a7772;
      --paper: #faf9f7; --paper-2: #f0ede8; --paper-3: #e4e0d9;
      --accent: #5c4ee8; --accent-2: #ede9ff; --accent-3: #c8c0f8;
      --serif: 'DM Serif Display', Georgia, serif;
      --sans: 'DM Sans', system-ui, sans-serif;
      --radius: 12px;
    }
    body { font-family: var(--sans); background: var(--paper); color: var(--ink); line-height: 1.6; }

    nav {
      position: sticky; top: 0; z-index: 100;
      display: flex; align-items: center; justify-content: space-between;
      padding: 0 clamp(1.5rem, 5vw, 4rem); height: 64px;
      background: rgba(250,249,247,.88); backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--paper-3);
    }
    .nav-logo { font-family: var(--serif); font-size: 1.25rem; color: var(--ink); text-decoration: none; }
    .nav-logo span { color: var(--accent); }
    .nav-links { display: flex; align-items: center; gap: 2rem; list-style: none; }
    .nav-links a { font-size: .875rem; color: var(--ink-2); text-decoration: none; transition: color .15s; }
    .nav-links a:hover, .nav-links a.active { color: var(--accent); }
    .nav-cta { background: var(--accent); color: #fff !important; padding: .5rem 1.25rem; border-radius: 8px; font-weight: 500 !important; }

    main { max-width: 720px; margin: 0 auto; padding: clamp(2rem, 5vw, 4rem) clamp(1.5rem, 5vw, 4rem); }

    .back-link { display: inline-flex; align-items: center; gap: .375rem; font-size: .875rem; color: var(--ink-3); text-decoration: none; margin-bottom: 2rem; transition: color .15s; }
    .back-link:hover { color: var(--accent); }

    .post-cover { width: 100%; aspect-ratio: 16/9; object-fit: cover; border-radius: var(--radius); margin-bottom: 2.5rem; display: block; }

    .post-tags { display: flex; gap: .5rem; flex-wrap: wrap; margin-bottom: 1rem; }
    .post-tag { font-size: .75rem; font-weight: 500; letter-spacing: .06em; text-transform: uppercase; color: var(--accent); background: var(--accent-2); padding: .25rem .625rem; border-radius: 100px; }

    .post-title { font-family: var(--serif); font-size: clamp(1.75rem, 4vw, 2.75rem); line-height: 1.1; letter-spacing: -0.02em; margin-bottom: 1rem; }
    .post-meta { font-size: .875rem; color: var(--ink-3); margin-bottom: 2.5rem; padding-bottom: 2rem; border-bottom: 1px solid var(--paper-3); }

    .content { line-height: 1.85; }
    .content h2 { font-family: var(--serif); font-size: 1.625rem; margin: 2.5rem 0 .875rem; letter-spacing: -0.01em; }
    .content h3 { font-family: var(--serif); font-size: 1.25rem; margin: 2rem 0 .625rem; }
    .content p { margin-bottom: 1.25rem; color: var(--ink-2); font-size: 1.0625rem; }
    .content ul, .content ol { padding-left: 1.5rem; margin-bottom: 1.25rem; color: var(--ink-2); font-size: 1.0625rem; }
    .content li { margin-bottom: .5rem; }
    .content strong { color: var(--ink); }
    .content a { color: var(--accent); }
    .content blockquote { border-left: 3px solid var(--accent-3); padding: .75rem 1.25rem; margin: 1.5rem 0; background: var(--accent-2); border-radius: 0 var(--radius) var(--radius) 0; }
    .content blockquote p { margin: 0; color: var(--ink-2); }
    .content code { background: var(--paper-2); padding: .125rem .375rem; border-radius: 4px; font-size: .875em; }
    .content pre { background: var(--ink); color: var(--paper); padding: 1.25rem; border-radius: var(--radius); overflow-x: auto; margin-bottom: 1.25rem; }
    .content pre code { background: none; padding: 0; }
    .content img { max-width: 100%; border-radius: var(--radius); margin: 1.5rem 0; }

    footer { background: var(--paper-2); border-top: 1px solid var(--paper-3); padding: 2.5rem clamp(1.5rem, 5vw, 4rem); margin-top: 5rem; }
    .footer-inner { max-width: 1100px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; }
    .footer-logo { font-family: var(--serif); font-size: 1.125rem; color: var(--ink); text-decoration: none; }
    .footer-logo span { color: var(--accent); }
    .footer-links { display: flex; gap: 1.5rem; list-style: none; }
    .footer-links a { font-size: .875rem; color: var(--ink-3); text-decoration: none; }
    .footer-links a:hover { color: var(--accent); }
    .footer-copy { font-size: .8125rem; color: var(--ink-3); }
  </style>
</head>
<body>

<nav>
  <a href="/" class="nav-logo">Notion<span>Flow</span></a>
  <ul class="nav-links">
    <li><a href="/templates">Templates</a></li>
    <li><a href="/blog" class="active">Blog</a></li>
    <li><a href="/about">About</a></li>
    <li><a href="/contact">Contact</a></li>
    <li><a href="/templates" class="nav-cta">Browse templates</a></li>
  </ul>
</nav>

<main>
  <a href="/blog" class="back-link">← Back to blog</a>

  {cover ? <img src={cover} alt={title} class="post-cover" /> : null}

  {tags && tags.length > 0 ? (
    <div class="post-tags">
      {tags.map(tag => <span class="post-tag">{tag}</span>)}
    </div>
  ) : null}

  <h1 class="post-title">{title}</h1>
  <p class="post-meta">{formattedDate}</p>

  <div class="content">
    <Content />
  </div>
</main>

<footer>
  <div class="footer-inner">
    <a href="/" class="footer-logo">Layer<span>Base</span></a>
    <ul class="footer-links">
      <li><a href="/templates">Templates</a></li>
      <li><a href="/blog">Blog</a></li>
      <li><a href="/about">About</a></li>
      <li><a href="/contact">Contact</a></li>
    </ul>
    <p class="footer-copy">© 2026 LayerBase</p>
  </div>
</footer>

</body>
</html>