---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const cleanSlug = (id: string) => id.replace(/\.mdx?$/, '');
  const templates = await getCollection('templates');
  const categories = ['All', ...new Set(templates.map(t => t.data.category))];

  return templates.map(t => ({
    params: { slug: cleanSlug(t.id) },
    props: { template: t, allTemplates: templates, categories },
  }));
}

interface Props {
  template:     CollectionEntry<'templates'>;
  allTemplates: CollectionEntry<'templates'>[];
  categories:   string[];
}

const { template, allTemplates, categories } = Astro.props;
const { Content } = await render(template);

const cleanSlug = (id: string) => id.replace(/\.mdx?$/, '');

const related = allTemplates
  .filter(t => t.id !== template.id && t.data.category === template.data.category)
  .slice(0, 2);

const { title, description, category, price, gumroadUrl } = template.data;
const categoryPath = (cat: string) => `/templates/category/${cat.toLowerCase()}`;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>{title} — NotionFlow</title>
  <meta name="description" content={description}/>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;1,9..40,300&display=swap" rel="stylesheet"/>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --ink: #0f0e0d; --ink-2: #3d3b38; --ink-3: #7a7772;
      --paper: #faf9f7; --paper-2: #f0ede8; --paper-3: #e4e0d9;
      --accent: #5c4ee8; --accent-2: #ede9ff; --accent-3: #c8c0f8;
      --teal-2: #e0f5ee; --amber-2: #fef0da;
      --serif: 'DM Serif Display', Georgia, serif;
      --sans: 'DM Sans', system-ui, sans-serif;
      --radius: 12px; --radius-lg: 20px;
    }
    body { font-family: var(--sans); background: var(--paper); color: var(--ink); line-height: 1.6; }

    nav {
      position: sticky; top: 0; z-index: 100;
      display: flex; align-items: center; justify-content: space-between;
      padding: 0 clamp(1.5rem, 5vw, 4rem); height: 64px;
      background: rgba(250,249,247,.88); backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--paper-3);
    }
    .nav-logo { font-family: var(--serif); font-size: 1.25rem; color: var(--ink); text-decoration: none; }
    .nav-logo span { color: var(--accent); }
    .nav-links { display: flex; align-items: center; gap: 2rem; list-style: none; }
    .nav-links a { font-size: .875rem; color: var(--ink-2); text-decoration: none; transition: color .15s; }
    .nav-links a:hover, .nav-links a.active { color: var(--accent); }
    .nav-cta { background: var(--accent); color: #fff !important; padding: .5rem 1.25rem; border-radius: 8px; font-weight: 500 !important; }

    main { max-width: 800px; margin: 0 auto; padding: clamp(2rem, 5vw, 4rem) clamp(1.5rem, 5vw, 4rem); }

    .template-eyebrow { font-size: .75rem; font-weight: 500; letter-spacing: .08em; text-transform: uppercase; color: var(--accent); margin-bottom: .875rem; }
    .template-title { font-family: var(--serif); font-size: clamp(1.75rem, 4vw, 2.75rem); line-height: 1.1; letter-spacing: -0.02em; margin-bottom: 1rem; }
    .template-desc { font-size: 1.0625rem; color: var(--ink-2); line-height: 1.7; margin-bottom: 2rem; }

    .meta-row {
      display: flex; align-items: center; gap: 1.5rem; flex-wrap: wrap;
      margin-bottom: 2rem; padding: 1.25rem; border-radius: var(--radius);
      background: var(--paper-2); border: 1px solid var(--paper-3);
    }
    .meta-item { font-size: .9375rem; color: var(--ink-2); }
    .meta-item strong { color: var(--ink); }
    .meta-item a { color: var(--accent); text-decoration: none; }
    .meta-item a:hover { text-decoration: underline; }
    .meta-price { font-size: 1.5rem; font-weight: 600; color: var(--ink); }

    .btn-buy {
      display: inline-block; background: var(--accent); color: #fff;
      padding: .875rem 2rem; border-radius: 10px;
      font-size: .9375rem; font-weight: 500;
      text-decoration: none; transition: opacity .15s; margin-bottom: 3rem;
    }
    .btn-buy:hover { opacity: .88; }

    .content { line-height: 1.8; }
    .content h2 { font-family: var(--serif); font-size: 1.5rem; margin: 2rem 0 .75rem; }
    .content h3 { font-size: 1.125rem; margin: 1.5rem 0 .5rem; }
    .content p { margin-bottom: 1rem; color: var(--ink-2); }
    .content ul, .content ol { padding-left: 1.5rem; margin-bottom: 1rem; color: var(--ink-2); }
    .content li { margin-bottom: .375rem; }

    .divider { border: none; border-top: 1px solid var(--paper-3); margin: 3rem 0; }

    .related-title { font-family: var(--serif); font-size: 1.5rem; margin-bottom: 1.5rem; }
    .related-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.25rem; }

    .template-card {
      background: #fff; border: 1px solid var(--paper-3);
      border-radius: var(--radius-lg); overflow: hidden;
      text-decoration: none; color: inherit;
      transition: transform .2s, box-shadow .2s, border-color .2s;
      display: flex; flex-direction: column;
    }
    .template-card:hover { transform: translateY(-3px); box-shadow: 0 12px 32px -4px rgba(0,0,0,.1); border-color: var(--accent-3); }
    .card-body { padding: 1.25rem; flex: 1; display: flex; flex-direction: column; }
    .card-cat { font-size: .7rem; font-weight: 500; letter-spacing: .07em; text-transform: uppercase; color: var(--accent); margin-bottom: .5rem; }
    .card-name { font-family: var(--serif); font-size: 1.125rem; line-height: 1.3; margin-bottom: .625rem; }
    .card-desc { font-size: .875rem; color: var(--ink-3); line-height: 1.6; flex: 1; margin-bottom: 1.25rem; }
    .card-footer { display: flex; align-items: center; justify-content: space-between; padding-top: .875rem; border-top: 1px solid var(--paper-2); }
    .card-price { font-size: 1.125rem; font-weight: 500; }
    .card-cta { font-size: .8125rem; font-weight: 500; color: var(--accent); }

    footer { background: var(--paper-2); border-top: 1px solid var(--paper-3); padding: 2.5rem clamp(1.5rem, 5vw, 4rem); }
    .footer-inner { max-width: 1100px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; }
    .footer-logo { font-family: var(--serif); font-size: 1.125rem; color: var(--ink); text-decoration: none; }
    .footer-logo span { color: var(--accent); }
    .footer-links { display: flex; gap: 1.5rem; list-style: none; }
    .footer-links a { font-size: .875rem; color: var(--ink-3); text-decoration: none; }
    .footer-links a:hover { color: var(--accent); }
    .footer-copy { font-size: .8125rem; color: var(--ink-3); }
  </style>
</head>
<body>

<nav>
  <a href="/" class="nav-logo">Notion<span>Flow</span></a>
  <ul class="nav-links">
    <li><a href="/templates">Templates</a></li>
    {categories.filter(c => c !== 'All').map(cat => (
      <li><a href={categoryPath(cat)} class={cat === category ? 'active' : ''}>{cat}</a></li>
    ))}
    <li><a href="/templates" class="nav-cta">Browse templates</a></li>
  </ul>
</nav>

<main>
  <p class="template-eyebrow">{category}</p>
  <h1 class="template-title">{title}</h1>
  <p class="template-desc">{description}</p>

  <div class="meta-row">
    <div class="meta-item">
      <strong>Category:</strong> <a href={categoryPath(category)}>{category}</a>
    </div>
    <div class="meta-item"><strong>Price:</strong></div>
    <div class="meta-price">€{price}</div>
  </div>

  <a href={gumroadUrl} target="_blank" rel="noopener noreferrer" class="btn-buy">Buy now →</a>

  <div class="content">
    <Content />
  </div>

  <hr class="divider" />

  {related.length > 0 ? (
    <section aria-label="Related templates">
      <h2 class="related-title">Related templates</h2>
      <div class="related-grid">
        {related.map(t => (
          <a href={`/templates/${cleanSlug(t.id)}`} class="template-card" data-cat={t.data.category}>
            <div class="card-body">
              <div class="card-cat">{t.data.category}</div>
              <div class="card-name">{t.data.title}</div>
              <div class="card-desc">{t.data.description}</div>
              <div class="card-footer">
                <div class="card-price">€{t.data.price}</div>
                <div class="card-cta">View details →</div>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>
  ) : null}
</main>

<footer>
  <div class="footer-inner">
    <a href="/" class="footer-logo">Notion<span>Flow</span></a>
    <ul class="footer-links">
      <li><a href="/templates">Templates</a></li>
      <li><a href="/blog">Blog</a></li>
      <li><a href="/about">About</a></li>
      <li><a href="/contact">Contact</a></li>
    </ul>
    <p class="footer-copy">© 2026 NotionFlow</p>
  </div>
</footer>

</body>
</html>